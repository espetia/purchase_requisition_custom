<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.requisition.reject.wizard.form</field>
        <field name="model">purchase.requisition.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Requisition">
                <group>
                    <field name="requisition_id" options="{'no_open': True}"/>
                    <field name="reason" placeholder="Explain to the requester why the requisition is rejected..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
