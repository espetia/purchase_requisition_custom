<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_expense_wizard_form" model="ir.ui.view">
        <field name="name">create.expense.wizard.form</field>
        <field name="model">create.expense.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Minor Expense">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                        <field name="concept"/>
                        <field name="description"/>
                        <field name="vehicle_id"/>
                    </group>
                    <group>
                        <field name="depto_id"/>
                        <field name="payment_journal_id"/>
                        <field name="currency_id"/>
                        <field name="amount"/>
                        <field name="date"/>
                        <field name="fortnight"/>
                        <field name="user_id"/>
                    </group>
                    <field name="requisition_id" invisible="1"/>
                </group>
                <notebook>
                    <page string="Lines to Expense">
                        <field name="line_ids" domain="[('requisition_id', '=', requisition_id), ('product_id', '!=', False), ('po_line_id', '=', False), ('expense_register_id', '=', False)]">
                            <tree create="0">
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="product_qty"/>
                                <field name="product_uom_id"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Create" type="object" name="action_create_expense" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_expense_wizard" model="ir.actions.act_window">
        <field name="name">Create Minor Expense</field>
        <field name="res_model">create.expense.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
