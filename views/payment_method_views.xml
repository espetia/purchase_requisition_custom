<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_payment_method_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.payment.method.tree</field>
        <field name="model">purchase.requisition.payment.method</field>
        <field name="arch" type="xml">
            <tree string="Payment Methods">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_requisition_payment_method_form" model="ir.ui.view">
        <field name="name">purchase.requisition.payment.method.form</field>
        <field name="model">purchase.requisition.payment.method</field>
        <field name="arch" type="xml">
            <form string="Payment Method">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_requisition_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">purchase.requisition.payment.method</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_purchase_requisition_payment_method"
              name="Payment Methods"
              parent="purchase.menu_purchase_config"
              action="action_purchase_requisition_payment_method"
              sequence="102"/>
</odoo>
