<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_purchase_requisition_custom_form" model="ir.ui.view">
            <field name="name">purchase.requisition.custom.form</field>
            <field name="model">purchase.requisition.custom</field>
            <field name="arch" type="xml">
                <form string="Purchase Requisition">
                    <header>
                        <field name="approval_status" invisible="1"/>
                        <field name="is_current_approver" invisible="1"/>
                        <button name="action_send_for_approval" string="Send for Approval" type="object" class="btn-primary"
                                attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('approval_status', 'not in', ('not_sent', 'rejected'))]}"/>
                        <button name="action_approve" string="Approve" type="object" class="btn-primary"
                                attrs="{'invisible': [('is_current_approver', '=', False)]}"/>
                        <button name="action_open_reject_wizard" string="Reject" type="object" class="btn-danger"
                                attrs="{'invisible': [('is_current_approver', '=', False)]}"/>
                        <button name="%(action_create_po_wizard)d" string="Create PO" type="action" class="btn-primary"
                                states="quote,waiting,authorized,done" groups="purchase.group_purchase_manager"/>
                        <button name="%(action_create_expense_wizard)d" string="Create Minor Expense" type="action" class="btn-secondary"
                                states="quote,waiting,authorized,done" attrs="{'invisible': [('can_create_minor_expense', '=', False)]}"/>
                        <field name="can_create_minor_expense" invisible="1"/>
                        <field name="can_edit_lines" invisible="1"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,preauthorized,quote,waiting,authorized,done,cancel" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning" role="alert" attrs="{'invisible': [('duplicate_requisition_ids', '=', [])]}">
                            <strong>Possible duplicate:</strong> there are draft requisitions in this department with similar data. Review them before saving to avoid purchasing twice.
                            <field name="duplicate_requisition_ids" readonly="1" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="requisition_name"/>
                                    <field name="requester_id"/>
                                    <field name="vehicle_id" optional="hide"/>
                                    <field name="create_date" string="Created on"/>
                                </tree>
                            </field>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                                    attrs="{'invisible': [('purchase_order_count', '=', 0)]}" groups="purchase_requisition_custom.group_purchase_requisition_user">
                                <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                            </button>
                            <button name="action_view_expense_registers" type="object" class="oe_stat_button" icon="fa-money"
                                    attrs="{'invisible': [('expense_register_count', '=', 0)]}" groups="purchase_requisition_custom.group_purchase_requisition_user">
                                <field name="expense_register_count" widget="statinfo" string="Minor Expenses"/>
                            </button>
                        </div>
                        <div class="mb-2" attrs="{'invisible': [('approval_status', '=', 'not_sent')]}">
                            <field name="approval_status" widget="badge" attrs="{'invisible': [('approval_status', '=', 'not_sent')]}"
                                   decoration-warning="approval_status == 'in_progress'" decoration-success="approval_status == 'approved'"
                                   decoration-danger="approval_status == 'rejected'"/>
                            <span attrs="{'invisible': [('current_approver_id', '=', False)]}" class="text-muted ml-2">
                                Waiting for <field name="current_approver_id" class="oe_inline" options="{'no_open': True}"/>
                                (<field name="approval_step" class="oe_inline"/>)
                            </span>
                        </div>
                        <div class="oe_title">
                            <span class="o_form_label">Folio</span>
                            <h1>
                                <field name="name"/>
                            </h1>
                            <span class="o_form_label">Purchase Reference</span>
                            <h2>
                                <field name="requisition_name" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('approval_status', '=', 'in_progress')]}"/>
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="requester_id" readonly="1" force_save="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="manager_id" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('approval_status', '=', 'in_progress')]}" options="{'no_create': True, 'no_create_edit': True}" context="{'show_job_title': True}"/>
                                <field name="department_id" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('approval_status', '=', 'in_progress')]}" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="need_rubro" invisible="1"/>
                                <field name="department_rubro_ids" invisible="1"/>
                                <field name="need_payment_method" invisible="1"/>
                                <field name="allow_minor_expense" invisible="1"/>
                                <field name="rubro_id" domain="[('id', 'in', department_rubro_ids)]" attrs="{'invisible': [('need_rubro', '=', False)], 'required': [('need_rubro', '=', True)], 'readonly': ['|', ('state', '!=', 'draft'), ('approval_status', '=', 'in_progress')]}" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="expiration_date" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('approval_status', '=', 'in_progress')]}"/>
                                <field name="requires_vehicle" invisible="1"/>
                                <field name="vehicle_id" attrs="{'invisible': [('requires_vehicle', '=', False)], 'required': [('requires_vehicle', '=', True)], 'readonly': ['|', ('state', '!=', 'draft'), ('approval_status', '=', 'in_progress')]}" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" attrs="{'readonly': [('can_edit_lines', '=', False)]}">
                                    <form string="Requisition Line">
                                        <sheet>
                                            <group>
                                                <group string="Product">
                                                    <field name="product_id" options="{'no_create': True, 'no_create_edit': True}" domain="[('purchase_ok', '=', True)]"/>
                                                    <field name="name"/>
                                                    <label for="product_qty"/>
                                                    <div class="o_row">
                                                        <field name="product_qty"/>
                                                        <field name="product_uom_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                                    </div>
                                                </group>
                                                <group string="Supplier">
                                                    <field name="supplier_suggestion"/>
                                                    <field name="attached_filename" invisible="1"/>
                                                    <field name="attached" filename="attached_filename" widget="binary_dropzone"
                                                           options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.bmp,.pdf,.xls,.xlsx', 'max_file_size_mb': 2}"/>
                                                </group>
                                            </group>
                                            <group>
                                                <group string="Payment">
                                                    <field name="payment_method_id" options="{'no_create': True, 'no_create_edit': True}"
                                                           attrs="{'required': [('parent.need_payment_method', '=', True)]}"/>
                                                    <field name="currency_id" invisible="1"/>
                                                    <field name="payment_import" widget="monetary"/>
                                                    <field name="need_invoice"/>
                                                </group>
                                                <group string="Traceability" groups="purchase_requisition_custom.group_purchase_requisition_user">
                                                    <field name="po_line_id" readonly="1"/>
                                                    <field name="expense_register_id" readonly="1"/>
                                                </group>
                                            </group>
                                            <group>
                                                <group string="Support">
                                                    <field name="consult_list_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                                    <field name="support_filename" invisible="1"/>
                                                    <field name="support_file" filename="support_filename" widget="binary_dropzone"
                                                           options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.bmp,.pdf,.xls,.xlsx', 'max_file_size_mb': 2}"/>
                                                </group>
                                            </group>
                                            <separator string="Comment"/>
                                            <field name="comment" nolabel="1" placeholder="Additional comments for this line..."/>
                                        </sheet>
                                    </form>
                                    <tree>
                                        <field name="product_id" width="300px" options="{'no_create': True, 'no_create_edit': True}" domain="[('purchase_ok', '=', True)]"/>
                                        <field name="name" width="220px"/>
                                        <field name="product_qty" width="100px"/>
                                        <field name="product_uom_id" width="150px" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="attached_filename" invisible="1"/>
                                        <field name="attached" filename="attached_filename" widget="binary" optional="show" width="200px"
                                               options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.bmp,.pdf,.xls,.xlsx'}"/>
                                        <field name="supplier_suggestion" optional="show" width="180px"/>
                                        <field name="need_invoice" optional="show" width="140px"/>
                                        <field name="payment_method_id" optional="show" width="160px" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="payment_import" widget="monetary" optional="show" width="120px"/>
                                        <field name="consult_list_id" optional="show" width="180px" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="support_filename" invisible="1"/>
                                        <field name="support_file" filename="support_filename" widget="binary" optional="show" width="200px"
                                               options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.bmp,.pdf,.xls,.xlsx'}"/>
                                        <field name="comment" optional="hide" width="220px"/>
                                        <field name="po_line_id" readonly="1" width="180px" groups="purchase_requisition_custom.group_purchase_requisition_user"/>
                                        <field name="expense_register_id" readonly="1" width="180px" groups="purchase_requisition_custom.group_purchase_requisition_user"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Authorizations" attrs="{'invisible': [('approval_ids', '=', [])]}">
                                <field name="approval_ids" readonly="1">
                                    <tree no_open="1" decoration-muted="state == 'waiting'" decoration-success="state == 'approved'"
                                          decoration-danger="state == 'rejected'" decoration-warning="state == 'pending'">
                                        <field name="sequence" invisible="1"/>
                                        <field name="user_id"/>
                                        <field name="state" widget="badge" decoration-warning="state == 'pending'"
                                               decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                                        <field name="date"/>
                                        <field name="comment"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Purchase Orders" groups="purchase_requisition_custom.group_purchase_requisition_user">
                                <field name="purchase_order_ids" readonly="1">
                                    <tree no_open="1" string="Purchase Orders">
                                        <field name="date_approve"/>
                                        <field name="partner_id"/>
                                        <field name="date_order"/>
                                        <field name="date_planned"/>
                                        <field name="amount_total" widget="monetary"/>
                                        <field name="state"/>
                                        <field name="currency_id" invisible="1"/>
                                        <button name="get_formview_action" type="object" string="Open" icon="fa-external-link" class="oe_highlight"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Minor Expenses" groups="purchase_requisition_custom.group_purchase_requisition_user"
                                  attrs="{'invisible': [('allow_minor_expense', '=', False)]}">
                                <field name="expense_register_ids" readonly="1">
                                    <tree no_open="1" string="Minor Expenses">
                                        <field name="date"/>
                                        <field name="partner_id"/>
                                        <field name="concept"/>
                                        <field name="amount" widget="monetary"/>
                                        <field name="state"/>
                                        <field name="currency_id" invisible="1"/>
                                        <button name="get_formview_action" type="object" string="Open" icon="fa-external-link" class="oe_highlight"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <separator string="Comments"/>
                        <field name="text_comment" nolabel="1" placeholder="Add your comments..." attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('approval_status', '=', 'in_progress')]}"/>
                        <field name="has_legacy_comments" invisible="1"/>
                        <separator string="Comments (Legacy)" attrs="{'invisible': [('has_legacy_comments', '=', False)]}"/>
                        <field name="comments" nolabel="1" readonly="1" attrs="{'invisible': [('has_legacy_comments', '=', False)]}"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_purchase_requisition_custom_tree" model="ir.ui.view">
            <field name="name">purchase.requisition.custom.tree</field>
            <field name="model">purchase.requisition.custom</field>
            <field name="arch" type="xml">
                <tree string="Purchase Requisitions" decoration-danger="expiration_date &lt; current_date and state in ('draft', 'quote')">
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="manager_id"/>
                    <field name="department_id"/>
                    <field name="rubro_id"/>
                    <field name="expiration_date"/>
                    <field name="approval_status" widget="badge" optional="show" decoration-warning="approval_status == 'in_progress'"
                           decoration-success="approval_status == 'approved'" decoration-danger="approval_status == 'rejected'"/>
                    <field name="current_approver_id" optional="show"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_purchase_requisition_custom_search" model="ir.ui.view">
            <field name="name">purchase.requisition.custom.search</field>
            <field name="model">purchase.requisition.custom</field>
            <field name="arch" type="xml">
                <search string="Search Requisitions">
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="manager_id"/>
                    <field name="department_id"/>
                    <field name="rubro_id"/>
                    <field name="current_approver_id"/>
                    <filter name="pending_my_approval" string="Pending my Authorization"
                            domain="[('current_approver_id', '=', uid), ('approval_status', '=', 'in_progress')]"/>
                    <filter name="in_authorization" string="In Authorization" domain="[('approval_status', '=', 'in_progress')]"/>
                    <filter name="rejected" string="Rejected" domain="[('approval_status', '=', 'rejected')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_approval_status" string="Authorization" context="{'group_by': 'approval_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_purchase_requisition_custom_kanban" model="ir.ui.view">
            <field name="name">purchase.requisition.custom.kanban</field>
            <field name="model">purchase.requisition.custom</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="1" group_create="false">
                    <field name="state"/>
                    <field name="name"/>
                    <field name="requisition_name"/>
                    <field name="requester_id"/>
                    <field name="manager_id"/>
                    <field name="department_id"/>
                    <field name="rubro_id"/>
                    <field name="expiration_date"/>
                    <field name="vehicle_id"/>
                    <field name="approval_status"/>
                    <field name="current_approver_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/> - <field name="requisition_name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        Requester: <field name="requester_id"/>
                                    </div>
                                    <div>
                                        Process Area: <field name="manager_id"/>
                                    </div>
                                    <div>
                                        Department: <field name="department_id"/>
                                    </div>
                                    <div t-if="record.rubro_id.raw_value">
                                        Rubro: <field name="rubro_id"/>
                                    </div>
                                    <div t-if="record.vehicle_id.raw_value">
                                        Vehicle: <field name="vehicle_id"/>
                                    </div>
                                    <div t-if="record.approval_status.raw_value == 'in_progress'" class="text-warning">
                                        Waiting for: <field name="current_approver_id"/>
                                    </div>
                                    <div t-if="record.approval_status.raw_value == 'rejected'" class="text-danger">
                                        Authorization rejected
                                    </div>
                                    <div t-if="record.expiration_date.raw_value and record.expiration_date.raw_value &lt; (new Date())" class="text-danger">
                                        Expired: <field name="expiration_date"/>
                                    </div>
                                    <div t-else="">
                                        Expires: <field name="expiration_date"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="action_purchase_requisition_custom" model="ir.actions.act_window">
            <field name="name">Purchase Requisitions</field>
            <field name="res_model">purchase.requisition.custom</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'show_job_title': True}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new purchase requisition
              </p>
            </field>
        </record>

        <!-- Pending Approvals: requisitions waiting for the current user's authorization -->
        <record id="view_purchase_requisition_custom_pending_tree" model="ir.ui.view">
            <field name="name">purchase.requisition.custom.pending.tree</field>
            <field name="model">purchase.requisition.custom</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <tree string="Pending Authorizations" create="false" delete="false">
                    <field name="name"/>
                    <field name="requisition_name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <field name="rubro_id"/>
                    <field name="expiration_date"/>
                    <field name="approval_step"/>
                    <field name="is_current_approver" invisible="1"/>
                    <button name="action_approve" type="object" string="Approve" icon="fa-check" class="btn-link text-success"
                            attrs="{'invisible': [('is_current_approver', '=', False)]}"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject" icon="fa-times" class="btn-link text-danger"
                            attrs="{'invisible': [('is_current_approver', '=', False)]}"/>
                </tree>
            </field>
        </record>

        <record id="action_purchase_requisition_pending_approval" model="ir.actions.act_window">
            <field name="name">Pending Authorizations</field>
            <field name="res_model">purchase.requisition.custom</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('current_approver_id', '=', uid), ('approval_status', '=', 'in_progress')]</field>
            <field name="context">{'show_job_title': True, 'create': False}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_purchase_requisition_custom_pending_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_purchase_requisition_custom_form')})]"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No requisitions are waiting for your authorization
              </p>
            </field>
        </record>

        <!-- Make Purchase Root Menu visible to Requisition Users -->
        <record id="purchase.menu_purchase_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('purchase_requisition_custom.group_purchase_requisition_user'))]"/>
        </record>

        <record id="purchase.menu_procurement_management" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <!-- Menu -->
        <menuitem id="menu_purchase_requisition_root"
                  name="Purchase Requisitions"
                  parent="purchase.menu_purchase_root"
                  sequence="15"/>

        <menuitem id="menu_purchase_requisition_custom"
                  name="Purchase Requisitions"
                  parent="menu_purchase_requisition_root"
                  action="action_purchase_requisition_custom"
                  sequence="10"/>

        <menuitem id="menu_purchase_requisition_pending_approval"
                  name="Pending Authorizations"
                  parent="menu_purchase_requisition_root"
                  action="action_purchase_requisition_pending_approval"
                  sequence="20"/>
    </data>
</odoo>
