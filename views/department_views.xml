<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_department_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.department.tree</field>
        <field name="model">purchase.requisition.department</field>
        <field name="arch" type="xml">
            <tree string="Departments">
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="need_rubro"/>
                <field name="rubro_ids" widget="many2many_tags" optional="show"/>
                <field name="need_payment_method"/>
                <field name="allow_minor_expense"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_requisition_department_form" model="ir.ui.view">
        <field name="name">purchase.requisition.department.form</field>
        <field name="model">purchase.requisition.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="need_rubro"/>
                        <field name="rubro_ids" widget="many2many_tags" options="{'no_create': True}"
                               attrs="{'invisible': [('need_rubro', '=', False)]}"/>
                        <field name="need_payment_method"/>
                        <field name="allow_minor_expense"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_requisition_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">purchase.requisition.department</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_purchase_requisition_department"
              name="Departments"
              parent="purchase.menu_purchase_config"
              action="action_purchase_requisition_department"
              sequence="101"/>
</odoo>
