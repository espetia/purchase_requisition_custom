<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_rubro_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.rubro.tree</field>
        <field name="model">purchase.requisition.rubro</field>
        <field name="arch" type="xml">
            <tree string="Rubros">
                <field name="name"/>
                <field name="requires_vehicle"/>
                <field name="approver_ids" widget="many2many_tags" string="Authorization Chain" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_requisition_rubro_form" model="ir.ui.view">
        <field name="name">purchase.requisition.rubro.form</field>
        <field name="model">purchase.requisition.rubro</field>
        <field name="arch" type="xml">
            <form string="Rubro">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="requires_vehicle"/>
                    </group>
                    <separator string="Authorization Chain"/>
                    <p class="text-muted">
                        Users who must authorize the requisitions of this rubro, in order. Each one is notified once the
                        previous one approves. Without a chain, requisitions are pre-authorized as soon as they are sent.
                    </p>
                    <field name="approver_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_requisition_rubro" model="ir.actions.act_window">
        <field name="name">Rubros</field>
        <field name="res_model">purchase.requisition.rubro</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_purchase_requisition_rubro"
              name="Rubros"
              parent="purchase.menu_purchase_config"
              action="action_purchase_requisition_rubro"
              sequence="100"/>
</odoo>