<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category for the module -->
    <record model="ir.module.category" id="module_category_purchase_requisition">
        <field name="name">Purchase Requisitions</field>
        <field name="description">Helps you manage purchase requisitions.</field>
        <field name="sequence">10</field>
    </record>

    <!-- Basic User Group -->
    <record id="group_purchase_requisition_user" model="res.groups">
        <field name="name">Basic Requisition User</field>
        <field name="category_id" ref="module_category_purchase_requisition"/>
    </record>

    <!-- Warehouse Agent Group -->
    <record id="group_purchase_requisition_warehouse" model="res.groups">
        <field name="name">Warehouse Agent</field>
        <field name="category_id" ref="module_category_purchase_requisition"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_requisition_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_purchase_requisition_manager" model="res.groups">
        <field name="name">Purchase Manager</field>
        <field name="category_id" ref="module_category_purchase_requisition"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_requisition_warehouse')), (4, ref('purchase.group_purchase_manager'))]"/>
    </record>

    <!-- Record Rules -->
    <!-- Basic User: own requisitions and those of the departments the user belongs to -->
    <record id="rule_purchase_requisition_own" model="ir.rule">
        <field name="name">Purchase Requisition: Own or Department</field>
        <field name="model_id" ref="model_purchase_requisition_custom"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('department_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_purchase_requisition_user'))]"/>
    </record>

    <!-- Manager: All requisitions -->
    <record id="rule_purchase_requisition_all" model="ir.rule">
        <field name="name">Purchase Requisition: All</field>
        <field name="model_id" ref="model_purchase_requisition_custom"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_requisition_manager'))]"/>
    </record>

    <!-- Requisition Lines: Basic User only on lines of the requisitions they can see (also guards the line
         attachments, which /web/content serves after checking access on the line) -->
    <record id="rule_purchase_requisition_line_own" model="ir.rule">
        <field name="name">Purchase Requisition Line: Own or Department Requisitions</field>
        <field name="model_id" ref="model_purchase_requisition_line_custom"/>
        <field name="domain_force">['|', ('requisition_id.requester_id', '=', user.id), ('requisition_id.department_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_purchase_requisition_user'))]"/>
    </record>

    <!-- Requisition Lines: Manager on all lines -->
    <record id="rule_purchase_requisition_line_all" model="ir.rule">
        <field name="name">Purchase Requisition Line: All</field>
        <field name="model_id" ref="model_purchase_requisition_line_custom"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_requisition_manager'))]"/>
    </record>

    <!-- Expense Register: Basic User can see minor expenses linked to the requisitions they can see -->
    <record id="rule_expense_register_requisition_user" model="ir.rule">
        <field name="name">Expense Register: Requisition-Linked, Own or Department Requisitions</field>
        <field name="model_id" ref="minor_expenses.model_expense_register"/>
        <field name="domain_force">['|', ('custom_requisition_id.requester_id', '=', user.id), ('custom_requisition_id.department_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_purchase_requisition_user'))]"/>
    </record>

    <!-- Expense Register: Purchase Managers can see all requisition-linked minor expenses -->
    <record id="rule_expense_register_requisition_manager" model="ir.rule">
        <field name="name">Expense Register: Requisition-Linked, All Managers</field>
        <field name="model_id" ref="minor_expenses.model_expense_register"/>
        <field name="domain_force">[('custom_requisition_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_requisition_manager'))]"/>
    </record>
</odoo>